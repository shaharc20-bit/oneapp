@Library('my-shared-library') _

pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        APP_DIR    = 'aws/app'
        IMAGE_NAME = 'shaharc20/flask-aws-monitor'
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/shaharc20-bit/oneapp.git'
            }
        }

        stage('Parallel Checks') {
            parallel {
                stage('flake8') {
                    steps { script { codeQuality.flake8(env.APP_DIR) } }
                }
                stage('hadolint') {
                    steps { script { codeQuality.hadolint("${env.APP_DIR}/Dockerfile") } }
                }
                stage('shellcheck') {
                    steps { script { codeQuality.shellcheck('aws') } }
                }
                stage('bandit') {
                    steps { script { securityScan.bandit(env.APP_DIR) } }
                }
                stage('trivy fs') {
                    steps { script { securityScan.trivyFs('aws') } }
                }
                stage('unit tests') {
                    steps { script { unitTest(env.APP_DIR) } }
                }
            }
        }

        stage('Build Docker Image') {
            steps { script { imageBuild.build(env.IMAGE_NAME, env.IMAGE_TAG, env.APP_DIR) } }
        }

        stage('Scan Image') {
            steps { script { securityScan.trivyImage("${env.IMAGE_NAME}:${env.IMAGE_TAG}") } }
        }

        stage('Push to Docker Hub') {
            steps { script { imageBuild.push(env.IMAGE_NAME, env.IMAGE_TAG) } }
        }
    }

    post {
        always {
            script { imageBuild.cleanup(env.IMAGE_NAME, env.IMAGE_TAG) }
            deleteDir()
        }
    }
}
