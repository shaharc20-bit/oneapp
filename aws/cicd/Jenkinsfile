pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Branch to build')
        booleanParam(name: 'MOCK_CHECKS', defaultValue: false, description: 'Run mock lint/security steps instead of the real tools')
        booleanParam(name: 'UPDATE_GITOPS', defaultValue: false, description: 'Bump the image tag in aws/gitops/flask-aws-monitor/dev on the dev branch')
    }

    environment {
        REPO_URL       = 'https://github.com/shaharc20-bit/oneapp.git'
        APP_DIR        = 'aws/app'
        DOCKERHUB_USER = 'shaharc20'
        IMAGE_NAME     = "${DOCKERHUB_USER}/flask-aws-monitor"
        IMAGE_TAG      = "${BUILD_NUMBER}"
        TRIVY_CACHE    = 'trivy-cache:/root/.cache/'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: params.BRANCH, url: env.REPO_URL
                sh 'git log -1 --oneline'
            }
        }

        stage('Parallel Checks') {
            parallel {
                stage('Lint: Python (flake8)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: flake8 aws/app'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q flake8 && flake8 ."'
                            }
                        }
                    }
                }
                stage('Lint: Dockerfile (hadolint)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: hadolint aws/app/Dockerfile'
                            } else {
                                sh 'docker run --rm -i hadolint/hadolint < $APP_DIR/Dockerfile'
                            }
                        }
                    }
                }
                stage('Lint: Shell (shellcheck)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: shellcheck aws/**/*.sh'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src koalaman/shellcheck:stable $(find aws -name "*.sh")'
                            }
                        }
                    }
                }
                stage('Security: Bandit') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: bandit -r aws/app'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q bandit && bandit -r . -x ./tests -ll"'
                            }
                        }
                    }
                }
                stage('Security: Trivy (fs)') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: trivy fs aws/'
                            } else {
                                sh 'docker run --rm -v "$WORKSPACE":/src -v $TRIVY_CACHE aquasec/trivy:latest fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 0 /src/aws'
                            }
                        }
                    }
                }
                stage('Unit Tests') {
                    steps {
                        script {
                            if (params.MOCK_CHECKS) {
                                echo 'MOCK: pytest aws/app/tests'
                            } else {
                                sh 'docker run --rm -e PYTHONDONTWRITEBYTECODE=1 -v "$WORKSPACE":/src -w /src/$APP_DIR python:3.12-slim sh -c "pip install -q -r requirements-dev.txt && python -m pytest -q -p no:cacheprovider tests"'
                            }
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest $APP_DIR'
            }
        }

        stage('Scan Image (Trivy)') {
            steps {
                script {
                    if (params.MOCK_CHECKS) {
                        echo "MOCK: trivy image ${IMAGE_NAME}:${IMAGE_TAG}"
                    } else {
                        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v $TRIVY_CACHE aquasec/trivy:latest image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 0 $IMAGE_NAME:$IMAGE_TAG'
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_TOKEN')]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                        docker push $IMAGE_NAME:$IMAGE_TAG
                        docker push $IMAGE_NAME:latest
                    '''
                }
            }
        }

        stage('Update GitOps (dev)') {
            when {
                expression { params.UPDATE_GITOPS }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        rm -rf gitops-work
                        git clone --branch dev "https://${GIT_USER}:${GIT_TOKEN}@github.com/shaharc20-bit/oneapp.git" gitops-work
                        cd gitops-work
                        sed -i "s/^  tag: .*/  tag: \\"${IMAGE_TAG}\\"/" aws/gitops/flask-aws-monitor/dev/values.yaml
                        git config user.name "jenkins"
                        git config user.email "jenkins@builder.local"
                        git add aws/gitops/flask-aws-monitor/dev/values.yaml
                        git commit -m "gitops(dev): flask-aws-monitor image ${IMAGE_TAG}" || echo "nothing to commit"
                        git push origin dev
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            sh 'docker image rm $IMAGE_NAME:$IMAGE_TAG || true'
            deleteDir()
        }
        success {
            echo "Pipeline completed successfully! Pushed ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo 'Pipeline failed! Check logs for details.'
        }
    }
}
